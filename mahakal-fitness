                <p>&copy; <span id="year"></span> Mahakal Fitness Dankuni. All Rights Reserved.</p>
                <p>Digital Growth Partner: <a href="https://geolift.co.in" target="_blank" class="text-gold-primary hover:underline font-bold">GeoLift Solutions</a></p>
            </div>
        </div>
    </footer>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile Menu Drawer
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Reviews Slider Data & Controls
        const reviewsData = [
            {
                name: "Rahul Roy",
                tag: "Verified Member • Dankuni",
                img: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150",
                text: "Lost 14 kg in 4 months under Head Coach Pradip Paswan's diet and training plan! Clean AC gym setup in Dankuni."
            },
            {
                name: "Pooja Sharma",
                tag: "Verified Member • Dankuni",
                img: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=150",
                text: "Safe and highly encouraging unisex environment for women. Floor trainers help correct posture during every workout."
            },
            {
                name: "Aritra Banerjee",
                tag: "Yearly Pass Member",
                img: "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=150",
                text: "At ₹5,999 per year with full AC access and heavy dumbbells, Mahakal Fitness offers incredible value."
            },
            {
                name: "Suman Ghosh",
                tag: "Verified Member • Dankuni",
                img: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150",
                text: "High quality gym equipment, proper AC cooling, and Coach Pradip always keeps an eye on exercise form."
            }
        ];

        let currentSlide = 0;
        const totalSlides = reviewsData.length;
        const reviewTrack = document.getElementById('reviewTrack');
        const dotsContainer = document.getElementById('dotsContainer');

        function updateSlidePosition() {
            const isMobile = window.innerWidth < 768;
            const cardWidthPercentage = isMobile ? 100 : 50;
            reviewTrack.style.transform = `translateX(-${currentSlide * cardWidthPercentage}%)`;

            Array.from(dotsContainer.children).forEach((dot, idx) => {
                if (idx === currentSlide) {
                    dot.className = "w-6 h-3 rounded-full bg-gold-primary transition-all";
                } else {
                    dot.className = "w-3 h-3 rounded-full bg-slate-700 hover:bg-gold-primary/60 transition-all";
                }
            });
        }

        function moveSlide(direction) {
            currentSlide = (currentSlide + direction + totalSlides) % totalSlides;
            updateSlidePosition();
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlidePosition();
        }

        function openReviewModal(index) {
            const data = reviewsData[index];
            document.getElementById('modalName').textContent = data.name;
            document.getElementById('modalTag').textContent = data.tag;
            document.getElementById('modalImg').src = data.img;
            document.getElementById('modalText').textContent = `"${data.text}"`;
            document.getElementById('reviewModal').classList.remove('hidden');
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').classList.add('hidden');
        }

        // Scroll to top
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 400) {
                scrollTopBtn.classList.remove('opacity-0');
                scrollTopBtn.classList.add('opacity-100');
            } else {
                scrollTopBtn.classList.remove('opacity-100');
                scrollTopBtn.classList.add('opacity-0');
            }
        });

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Fitness Calculator
        function calculateFitness() {
            const age = parseFloat(document.getElementById('calcAge').value);
            const gender = document.getElementById('calcGender').value;
            const weight = parseFloat(document.getElementById('calcWeight').value);
            const height = parseFloat(document.getElementById('calcHeight').value);

            if (!weight || !height || !age) return;

            const heightM = height / 100;
            const bmi = (weight / (heightM * heightM)).toFixed(1);

            let category = "Normal Weight";
            if (bmi < 18.5) category = "Underweight";
            else if (bmi >= 25 && bmi < 29.9) category = "Overweight";
            else if (bmi >= 30) category = "Obese";

            let bmr = (10 * weight) + (6.25 * height) - (5 * age);
            bmr = (gender === 'male') ? bmr + 5 : bmr - 161;
            const dailyCalories = Math.round(bmr * 1.55);

            document.getElementById('bmiVal').textContent = bmi;
            document.getElementById('bmiCategory').textContent = category;
            document.getElementById('bmrVal').textContent = dailyCalories.toLocaleString();
        }

        window.onload = function() {
            updateSlidePosition();
        };
    </script>
</body>
</html>
